generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMERACIONES (ENUMS)
// ==========================================

enum RolUsuario {
  ADMIN
  MODERADOR
  CLIENTE
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum TipoDescuento {
  PORCENTAJE
  MONTO_FIJO
  ENVIO_GRATIS
}

enum ObjetivoDescuento {
  TODO
  PRODUCTOS_ESPECIFICOS
  CATEGORIAS_ESPECIFICAS
}

enum TipoVivienda {
  CASA
  DEPARTAMENTO
  OFICINA
  LOCAL_COMERCIAL
  OTRO
}

enum EstadoPedido {
  PENDIENTE
  PREPARANDO
  ENVIADO
  EN_REPARTO
  ENTREGADO
  INTENTO_FALLIDO
  RETRASADO
  DEVUELTO
  CANCELADO
}

enum MetodoPago {
  TARJETA
  TRANSFERENCIA
  EFECTIVO
  PAGO_ENTREGA
}

// ==========================================
// MODELOS DE USUARIOS Y PERFILES (Estrictos)
// ==========================================

model Usuario {
  id       String        @id @default(cuid())
  email    String        @unique
  password String
  telefono String?
  avatar   String?
  rol      RolUsuario    @default(CLIENTE)
  estado   EstadoUsuario @default(ACTIVO)

  // Datos personales validados
  primerNombre    String
  segundoNombre   String?
  primerApellido  String
  segundoApellido String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  perfilStaff   PerfilStaff?
  perfilCliente PerfilCliente?
  pedidos       Pedido[]
  direcciones   Direccion[]
  descuentosUsos DescuentoUso[]
  borradores    PedidoBorrador[]

  @@index([email])
  @@index([rol])
  @@index([estado])
  @@map("usuarios")
}

model PerfilStaff {
  usuarioId String  @id
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rut       String  @unique
  cargo     String?

  @@map("perfiles_staff")
}

model PerfilCliente {
  usuarioId       String    @id
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  fechaNacimiento DateTime?
  puntos          Int       @default(0)

  @@map("perfiles_clientes")
}

// ==========================================
// MODELOS DE PRODUCTOS Y CATALOGO
// ==========================================

model Categoria {
  id        String   @id @default(cuid())
  nombre    String
  slug      String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos  Producto[]
  descuentos Descuento[]

  @@index([slug])
  @@index([activo])
  @@map("categorias")
}

model Producto {
  id                String   @id @default(cuid())
  nombre            String
  slug              String   @unique
  descripcion       String?
  precio            Int
  precioComparacion Int?
  stock             Int      @default(0)
  imagenPrincipal   String?
  imagenes          String[]
  novedad           Boolean  @default(false)
  destacado         Boolean  @default(false)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categoriaId String
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  itemsPedido ItemPedido[]
  descuentos  Descuento[]

  @@index([categoriaId])
  @@index([slug])
  @@index([activo])
  @@index([destacado])
  @@index([novedad])
  @@index([precio])
  @@map("productos")
}

model Descuento {
  id                  String            @id @default(cuid())
  nombre              String
  codigo              String?           @unique
  tipo                TipoDescuento
  valor               Int
  objetivo            ObjetivoDescuento @default(TODO)
  fechaInicio         DateTime          @default(now())
  fechaFin            DateTime?
  activo              Boolean           @default(true)
  valorMinimoPedido   Int?
  limiteUso           Int?
  limiteUsoPorUsuario Int?
  contadorUso         Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  productos  Producto[]
  categorias Categoria[]
  pedidos    Pedido[]
  usos       DescuentoUso[]

  @@index([codigo])
  @@index([activo])
  @@index([fechaInicio, fechaFin])
  @@map("descuentos")
}

model DescuentoUso {
  id          String    @id @default(cuid())
  descuentoId String
  descuento   Descuento @relation(fields: [descuentoId], references: [id])
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  pedidoId    String?
  pedido      Pedido?   @relation(fields: [pedidoId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([descuentoId, usuarioId, pedidoId])
  @@index([descuentoId, usuarioId])
  @@map("descuentos_usos")
}

// ==========================================
// MODELOS DE UBICACION Y DIRECCIONES
// ==========================================

model Region {
  id        String   @id @default(cuid())
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comunas Comuna[]

  @@index([nombre])
  @@map("regiones")
}

model Comuna {
  id        String   @id @default(cuid())
  nombre    String
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  direcciones Direccion[]

  @@index([regionId])
  @@index([nombre])
  @@map("comunas")
}

model Direccion {
  id           String       @id @default(cuid())
  calle        String
  numero       String
  ciudad       String?
  codigoPostal String?
  isDefault    Boolean      @default(false)
  tipoVivienda TipoVivienda @default(CASA)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  comunaId String
  comuna   Comuna @relation(fields: [comunaId], references: [id])

  // OPCIONAL: Si es null, fue una dirección de 1 solo uso (invitado o "no guardar")
  // Si tiene ID, es una dirección guardada en la libreta del cliente
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  pedidos Pedido[]

  @@index([comunaId])
  @@index([usuarioId])
  @@index([isDefault])
  @@map("direcciones")
}

// ==========================================
// MODELOS DE COMPRAS Y LOGÍSTICA (Flexibles)
// ==========================================

model Pedido {
  id           String       @id @default(cuid())
  numeroPedido String       @unique
  estado       EstadoPedido @default(PENDIENTE)
  subtotal     Int
  costoEnvio   Int          @default(0)
  total        Int
  metodoPago   MetodoPago
  notas        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Campos agregados para Pasarelas de Pago externas
  transaccionId   String? @unique
  comprobantePago String?

  // Datos del destinatario (Snapshot histórico)
  primerNombreDestinatario   String
  primerApellidoDestinatario String
  emailDestinatario          String
  telefonoDestinatario       String

  // Relaciones
  usuarioId String? // OPCIONAL: Si es null, fue compra de invitado. Si tiene ID, se asocia al historial del cliente.
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  direccionId String
  direccion   Direccion @relation(fields: [direccionId], references: [id])

  descuentoId String?
  descuento   Descuento? @relation(fields: [descuentoId], references: [id])

  items ItemPedido[]
  envio Envio?
  descuentosUsos DescuentoUso[]

  // Token único para que un invitado pueda consultar su pedido sin login
  trackingToken String? @unique

  @@index([usuarioId])
  @@index([numeroPedido])
  @@index([estado])
  @@index([createdAt])
  @@index([descuentoId])
  @@index([trackingToken])
  @@map("pedidos")
}

model ItemPedido {
  id       String @id @default(cuid())
  nombre   String
  precio   Int
  cantidad Int
  total    Int

  pedidoId   String
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  @@index([pedidoId])
  @@index([productoId])
  @@map("items_pedido")
}

model Envio {
  id                   String    @id @default(cuid())
  numeroTracking       String?
  metodoEnvio          String
  empresaLogistica     String?
  fechaEstimadaEntrega DateTime
  fechaEntregada       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@index([numeroTracking])
  @@index([fechaEstimadaEntrega])
  @@map("envios")
}

model PedidoBorrador {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  cartId    String?

  recipient      Json?
  address        Json?
  shippingMethod String?
  paymentMethod  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@index([updatedAt])
  @@map("pedidos_borrador")
}
